# ==============================================================================
# LAD GLOBAL TRAVELS AND TOURS — PRODUCTION CONFIGURATION TEMPLATE
# Copy/Rename this file to `.env` on your cPanel server outside the web root.
# Set file permissions to chmod 600 (Private).
# DO NOT COMMIT LIVE PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_NAME="LAD Global Travels and Tours"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ladglobaltravels.com
APP_SECRET=replace_with_64_character_hexadecimal_key_for_session_encryption

# Database Configuration (Created in cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_database_name
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=your_cpanel_database_password

# Session Security (Enforces secure cookies over HTTPS)
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true

# Corporate Contact Information
COMPANY_NAME="LAD Global Travels and Tours"
COMPANY_TAGLINE="Explore • Discover • Experience"
COMPANY_PHONE="07017597650"
COMPANY_WHATSAPP="2347017597650"
COMPANY_EMAIL="info@ladglobaltravels.com"
COMPANY_ADDRESS="SF41, Ikorodu Complex, Ita Elewa, adjacent to High Court, Ikorodu, Lagos, Nigeria"
COMPANY_HOURS="Monday - Friday: 9:00 AM - 5:30 PM | Saturday: 10:00 AM - 2:00 PM"

# Official Social Profiles
SOCIAL_INSTAGRAM="https://instagram.com/ladglobaltravels"
SOCIAL_FACEBOOK="https://facebook.com/ladglobaltravels"
SOCIAL_LINKEDIN=""

# Verified Corporate Bank Details (Zenith Bank)
BANK_NAME="Zenith Bank PLC"
BANK_ACCOUNT_NAME="LAD Global Travels and Tours Limited"
BANK_ACCOUNT_NUMBER="1017399000"
BANK_SORT_CODE="057"
BANK_TRANSFER_INSTRUCTIONS="Please use your Booking Reference (BK-XXXX) as payment narration."

# Paystack Payment Gateway (Replace with Live keys when ready to accept real payments)
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_CURRENCY=NGN

# Outbound Email / Transactional SMTP Settings (Section 11)
SMTP_HOST=mail.ladglobaltravels.com
SMTP_PORT=465
SMTP_USERNAME=info@ladglobaltravels.com
SMTP_PASSWORD=your_email_password
SMTP_ENCRYPTION=ssl
SMTP_FROM_ADDRESS=info@ladglobaltravels.com
SMTP_FROM_NAME="LAD Global Travels and Tours"

# Internal Administrative Notification Routing
ADMIN_NOTIFICATION_EMAIL=info@ladglobaltravels.com

