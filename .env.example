# ==============================================================================
# LAD GLOBAL TRAVELS AND TOURS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in your private deployment environment (outside public webroot).
# NEVER commit real credentials or .env files to source control.
# ==============================================================================

# Application Settings
APP_NAME="LAD Global Travels and Tours"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=replace_with_64_char_cryptographic_random_string

# Database Configuration (MySQL 8+ / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lad_global_db
DB_USERNAME=root
DB_PASSWORD=

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false

# Corporate Contact Settings
COMPANY_NAME="LAD Global Travels and Tours"
COMPANY_TAGLINE="Explore • Discover • Experience"
COMPANY_PHONE="07017597650"
COMPANY_WHATSAPP="2347017597650"
COMPANY_EMAIL="info@ladglobal.com"
COMPANY_ADDRESS="SF41, Ikorodu Complex, Ita Elewa, adjacent to High Court, Ikorodu, Lagos, Nigeria"
COMPANY_HOURS="Monday - Friday: 9:00 AM - 5:30 PM | Saturday: 10:00 AM - 2:00 PM"

# Official Social Media URLs (Public profiles; no APIs required)
SOCIAL_INSTAGRAM="https://instagram.com/ladglobaltravels"
SOCIAL_FACEBOOK="https://facebook.com/ladglobaltravels"
SOCIAL_LINKEDIN=""

# Verified Corporate Bank Details (Manual Transfer — Decision D04)
BANK_NAME="Zenith Bank PLC"
BANK_ACCOUNT_NAME="LAD Global Travels and Tours Limited"
BANK_ACCOUNT_NUMBER="1012345678"
BANK_SORT_CODE=""
BANK_TRANSFER_INSTRUCTIONS="Please use your Booking Reference (BK-XXXX) as payment narration."

# Paystack API Credentials (Test mode for development; Live mode pending authorized launch)
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_CURRENCY=NGN

# Outbound Email SMTP Settings (Required for Phase P08)
SMTP_HOST=mail.ladglobal.com
SMTP_PORT=587
SMTP_USERNAME=info@ladglobal.com
SMTP_PASSWORD=placeholder_smtp_password
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=info@ladglobal.com
SMTP_FROM_NAME="LAD Global Travels and Tours"

# SOT Section 11 Designated Domain Mailboxes & Routing
MAILBOX_INFO=info@ladglobal.com
MAILBOX_SALES=sales@ladglobal.com
MAILBOX_VISA=visa@ladglobal.com
MAILBOX_ADMIN=admin@ladglobal.com
MAILBOX_LANRE=lanre@ladglobal.com

# Notification Destination Routing
NOTIFICATION_EMAIL_ENQUIRIES=sales@ladglobal.com
NOTIFICATION_EMAIL_VISA=visa@ladglobal.com
NOTIFICATION_EMAIL_PAYMENTS=admin@ladglobal.com
NOTIFICATION_EMAIL_MANAGEMENT=lanre@ladglobal.com
